# Normal application entry point: link Launch and copy its bundled DLLs.
function(licentivo_launch_link target)
  if(ARGC GREATER 1 AND ARGV1 STREQUAL "CXX")
    target_link_libraries(${target} PRIVATE LicentivoLaunch::CPP)
  else()
    target_link_libraries(${target} PRIVATE LicentivoLaunch::Account)
  endif()
  if(WIN32 AND EXISTS "${LICENTIVO_LAUNCH_CURL_ROOT}/bin")
    file(GLOB _launch_runtime_dlls "${LICENTIVO_LAUNCH_CURL_ROOT}/bin/*.dll")
    foreach(_launch_dll IN LISTS _launch_runtime_dlls)
      add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_launch_dll}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
    endforeach()
  endif()
endfunction()
