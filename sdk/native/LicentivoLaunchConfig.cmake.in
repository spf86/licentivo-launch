@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(LICENTIVO_LAUNCH_CURL_ROOT "${PACKAGE_PREFIX_DIR}/third_party/curl")
if(WIN32 AND EXISTS "${LICENTIVO_LAUNCH_CURL_ROOT}/include/curl/curl.h")
  set(CURL_ROOT "${LICENTIVO_LAUNCH_CURL_ROOT}")
endif()
find_dependency(Licentivo 0.11.2 EXACT CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../Licentivo" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/LicentivoLaunchTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LaunchRuntime.cmake")
