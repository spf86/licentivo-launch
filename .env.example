# The binary reads process environment variables, not this file automatically.
# Docker Compose reads .env. Never commit the populated .env file.
LAUNCH_ENV=development
LAUNCH_HTTP_ADDR=127.0.0.1:8080
# Optional built-in HTTPS listener. It must use a different address/port from HTTP.
# After it is enabled, an administrator can upload/replace the certificate and
# switch the public protocol in System Settings without restarting the process.
# LAUNCH_HTTPS_ADDR=0.0.0.0:8443
LAUNCH_PUBLIC_URL=http://localhost:8080
# Uploaded Windows, macOS, iOS and Android installers. Defaults to .local/uploads.
# Back up this directory together with the encrypted database backup.
LAUNCH_UPLOAD_DIR=.local/uploads
# Configure an existing empty database. GORM creates the tables on startup.
# LAUNCH_DATABASE_DSN=launch:YOUR_PASSWORD@tcp(127.0.0.1:3306)/launch
# Generate with: go run ./cmd/launch keygen
LAUNCH_MASTER_KEY=
# Optional first-start administrator overrides. Existing accounts are preserved.
# Defaults: admin@example.com / LaunchAdmin123! (must change on first login).
# LAUNCH_ADMIN_EMAIL=admin@example.com
# LAUNCH_ADMIN_PASSWORD=LaunchAdmin123!
# Compose only; supply separate random credentials.
MYSQL_DATABASE=launch
MYSQL_USER=launch
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
