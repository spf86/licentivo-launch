{
  "openapi": "3.1.0",
  "info": {
    "title": "Licentivo Launch expiry reminder administration API",
    "version": "1.0.0",
    "description": "Site-wide email budgets are managed in Email & registration. Reminders scan hourly, have lowest priority, and cannot consume the protected authentication/transaction reserve. All instances must use the same site database."
